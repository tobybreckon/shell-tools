#!/bin/bash

#########################################################################################

# rotate the Nth page (only) of a PDF file

# (c) Toby Breckon, 2026
# License: http://www.gnu.org/licenses/gpl.txt

#########################################################################################

# get command name from command call

COMMAND_NAME=`basename "$0"`

#########################################################################################

# check number of arguments

if [ "$#" -ne 3 ]; then
    echo
    echo "Usage: $COMMAND_NAME N input.pdf output.pdf"
    echo
    echo "Rotate Nth page (only) of a specified PDF file"
    echo
    exit 1
fi

rotated=$1
INPUT_FILE=$2
OUTPUT_FILE=$3

#########################################################################################

# check pdftk and pdfinfo are available

for NEEDED in "pdftk:pdftk:pdftk" "pdfinfo:pdfinfo:poppler-tools / poppler-utils"; do
  NEEDED_COMMAND=${NEEDED%%:*}
  NEEDED_LONGNAME=${NEEDED#*:}; NEEDED_LONGNAME=${NEEDED_LONGNAME%%:*}
  NEEDED_PACKAGE=${NEEDED##*:}
  if ! command -v "$NEEDED_COMMAND" >/dev/null 2>&1; then
    echo "$COMMAND_NAME ERROR: required $NEEDED_LONGNAME package (package name: $NEEDED_PACKAGE) NOT installed."
    echo
    exit 1
  fi
done

#########################################################################################

# check input file exists and page number is valid

if [ ! -f "$INPUT_FILE" ]; then
  echo "$COMMAND_NAME ERROR: input file '$INPUT_FILE' does not exist."
  exit 1
fi

pages=$(pdfinfo "$INPUT_FILE" 2>/dev/null | awk '/^Pages:/ {print $2}')

if [ -z "$pages" ]; then
  echo "$COMMAND_NAME ERROR: cannot read page count from '$INPUT_FILE' (not a valid PDF?)."
  exit 1
fi

case "$rotated" in
  ''|*[!0-9]*)
    echo "$COMMAND_NAME ERROR: page number N must be a positive integer (got '$rotated')."
    exit 1
    ;;
esac

if [ "$rotated" -lt 1 ] || [ "$rotated" -gt "$pages" ]; then
  echo "$COMMAND_NAME ERROR: page number N must be between 1 and $pages (got $rotated)."
  exit 1
fi

#########################################################################################

# check for file overwrite as a safeguard

FILE_TO_CHECK=$OUTPUT_FILE
if [ -e "$FILE_TO_CHECK" ]; then
  echo "Output file '$FILE_TO_CHECK' already exists."
  read -p "Do you want to overwrite it? (y/n): " overwrite
  case "$overwrite" in
    y|Y)
      echo "Overwriting $FILE_TO_CHECK..."
      ;;
    *)
      echo "Aborting. File '$FILE_TO_CHECK' was not overwritten."
      exit 1
      ;;
  esac
fi

#########################################################################################

#### perform rotation of Nth PDF page (all other pages are left unchanged)

pdftk "$INPUT_FILE" rotate "${rotated}east" output "$OUTPUT_FILE"
exit $?

#########################################################################################
